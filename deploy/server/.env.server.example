# 服务器 Docker Compose 环境变量模板。
# 将本文件复制为服务器部署目录中的 .env，填写真实值后 chmod 600 .env。
# 实际密码应放在仓库根目录 .env（该文件已被 Git 忽略），不要提交。

COMPOSE_PROJECT_NAME=primary-math-platform
TZ=Asia/Shanghai

# PostgreSQL
DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
REDIS_PORT=6379
REDIS_MAXMEMORY=64mb

# Nacos（NACOS_AUTH_TOKEN 需要是 Base64 编码后的 32+ 字符随机原文）
NACOS_SERVER_PORT=8848
NACOS_CONSOLE_PORT=8847
NACOS_GRPC_PORT=9848
NACOS_GRPC_CLIENT_PORT=9849
NACOS_JVM_XMS=128m
NACOS_JVM_XMX=256m
NACOS_JVM_XMN=128m
NACOS_AUTH_IDENTITY_KEY=REPLACE_WITH_A_RANDOM_SECRET
NACOS_AUTH_IDENTITY_VALUE=REPLACE_WITH_A_RANDOM_SECRET
NACOS_AUTH_TOKEN=REPLACE_WITH_A_BASE64_RANDOM_SECRET
NACOS_USERNAME=nacos
NACOS_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# RabbitMQ
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 仅在启用 --profile observability 时使用
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=7d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# 在服务器执行 `stat -c '%g' /var/run/docker.sock`，将输出值填入 DOCKER_GID。
JENKINS_WEB_PORT=8080
DOCKER_GID=REPLACE_WITH_DOCKER_SOCKET_GID
JENKINS_JAVA_OPTS=-Xms128m -Xmx320m -XX:MaxMetaspaceSize=160m -Djava.awt.headless=true
JENKINS_ADMIN_USERNAME=admin
JENKINS_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
