{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "sum(rate(ai_agent_runs_total[5m]))", "legendFormat": "runs/s", "refId": "A" }],
      "title": "Agent 请求速率",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "sum(rate(ai_agent_runs_total{status=\"SUCCEEDED\"}[15m])) / clamp_min(sum(rate(ai_agent_runs_total[15m])), 0.000001)", "legendFormat": "success", "refId": "A" }],
      "title": "运行成功率",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_agent_run_duration_seconds_bucket[15m])))", "legendFormat": "p95", "refId": "A" }],
      "title": "P95 运行时延",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "ai_agent_inflight_runs", "legendFormat": "inflight", "refId": "A" }],
      "title": "运行中请求",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (tool, status) (rate(ai_agent_tool_calls_total[5m]))", "legendFormat": "{{tool}} / {{status}}", "refId": "A" }],
      "title": "工具调用与失败",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by (rating) (increase(ai_agent_feedback_total[1h]))", "legendFormat": "feedback / {{rating}}", "refId": "A" },
        { "expr": "rate(ai_agent_rag_hits_sum[5m]) / clamp_min(rate(ai_agent_rag_hits_count[5m]), 0.000001)", "legendFormat": "avg rag hits", "refId": "B" }
      ],
      "title": "RAG 与用户反馈",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": ["ai", "agent", "rag"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "教学 Agent 运行总览",
  "uid": "teaching-agent-overview",
  "version": 1
}
