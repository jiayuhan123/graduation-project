# Spring
SPRING_PROFILES_ACTIVE=server
SERVER_PORT=10000
TZ=Asia/Shanghai

# PostgreSQL（开发环境直接使用服务器上的单体数据库）
DB_HOST=122.51.234.113
POSTGRES_PORT=5432
MONOLITH_DB_NAME=monolith_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Redis（Sa-Token、登录限制、微信登录状态，直接使用服务器实例）
REDIS_HOST=122.51.234.113
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0

# RabbitMQ（领域事件与 outbox 投递，直接使用服务器实例）
RABBITMQ_HOST=122.51.234.113
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=monolith
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# 阿里云 OSS（文件接口需要真实配置）
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
OSS_BUCKET=replace-me

# 内部接口默认关闭；需要开启时必须同时配置强随机 token
INTERNAL_API_ENABLED=false
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# 可选：首次启动创建管理员
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
