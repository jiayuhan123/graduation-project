{
  "name": "management",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{vue,css,scss}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check": "npm run lint && npm run lint:style && npm run format && npm run type-check && npm run test:unit && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.32",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.1",
    "axios": "^1.19.0",
    "element-plus": "^2.9.4",
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10",
    "sass": "^1.83.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
