.avatar-preview {
  display: flex;
  padding: 24rpx 0 12rpx;
  flex-direction: column;
  align-items: center;
}

.avatar-selector {
  position: relative;
  display: block;
  margin: 0;
  padding: 0;
  overflow: visible;
  background: transparent;
  border-radius: 50%;
  line-height: normal;
}

.avatar-selector::after {
  border: 0;
}

.avatar-preview__circle {
  display: flex;
  width: 138rpx;
  height: 138rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(135deg, #ffad73, #ff7a2a);
  border: 8rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 14rpx 32rpx rgba(255, 122, 42, 0.24);
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 750;
}

.avatar-preview__image {
  width: 100%;
  height: 100%;
}

.avatar-preview__badge {
  position: absolute;
  right: -2rpx;
  bottom: 2rpx;
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #ffe0ca;
  border-radius: 50%;
  box-shadow: 0 6rpx 16rpx rgba(45, 52, 54, 0.14);
  font-size: 22rpx;
}

.avatar-preview__tip {
  margin-top: 20rpx;
  color: #9aa0a6;
  font-size: 22rpx;
}
