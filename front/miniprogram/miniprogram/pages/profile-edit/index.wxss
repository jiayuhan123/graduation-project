.avatar-preview {
  display: flex;
  padding: 24rpx 0 12rpx;
  flex-direction: column;
  align-items: center;
}

.avatar-selector {
  position: relative;
  display: block;
  margin: 0;
  padding: 0;
  overflow: visible;
  background: transparent;
  border-radius: 50%;
  line-height: normal;
}

.avatar-selector::after {
  border: 0;
}

.avatar-preview__circle {
  display: flex;
  width: 138rpx;
  height: 138rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--app-primary);
  border: 8rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: none;
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 600;
}

.avatar-preview__image {
  width: 100%;
  height: 100%;
}

.avatar-preview__badge {
  position: absolute;
  right: -2rpx;
  bottom: 2rpx;
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid var(--app-line);
  border-radius: 50%;
  box-shadow: none;
  font-size: 22rpx;
}

.avatar-preview__tip {
  margin-top: 20rpx;
  color: var(--app-muted);
  font-size: 22rpx;
}
