<view class="app-page page-shell">
  <view wx:if="{{loading}}" class="page-loading">
    <t-loading theme="circular" size="52rpx" text="正在加载" />
  </view>

  <block wx:else>
    <view class="avatar-preview">
      <button class="avatar-selector" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-preview__circle">
          <image
            wx:if="{{avatarUrl}}"
            class="avatar-preview__image"
            src="{{avatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else>{{avatarText}}</text>
        </view>
        <view class="avatar-preview__badge">
          <t-icon name="camera" size="40rpx" color="#52705f" />
        </view>
      </button>
      <text class="avatar-preview__tip">点击头像选择新图片，保存资料后生效</text>
    </view>

    <text class="section-heading">基本信息</text>
    <view class="surface-card">
      <view class="field">
        <text class="field__label">昵称</text>
        <input
          class="field__control"
          maxlength="50"
          placeholder="请输入昵称"
          value="{{nickname}}"
          data-field="nickname"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field">
        <text class="field__label">真实姓名</text>
        <input
          class="field__control"
          maxlength="50"
          placeholder="请输入真实姓名"
          value="{{realName}}"
          data-field="realName"
          bindinput="onFieldInput"
        />
      </view>
    </view>

    <text class="section-heading">联系方式</text>
    <view class="surface-card">
      <view class="field">
        <text class="field__label">手机号</text>
        <input
          class="field__control"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          data-field="phone"
          bindinput="onFieldInput"
        />
      </view>
      <view class="field">
        <text class="field__label">邮箱</text>
        <input
          class="field__control"
          type="text"
          maxlength="254"
          placeholder="请输入邮箱"
          value="{{email}}"
          data-field="email"
          bindinput="onFieldInput"
        />
      </view>
    </view>

    <view class="form-actions">
      <t-button
        block
        size="large"
        shape="rectangle"
        theme="primary"
        loading="{{saving}}"
        bind:tap="handleSave"
      >
        保存资料
      </t-button>
    </view>
  </block>
</view>
