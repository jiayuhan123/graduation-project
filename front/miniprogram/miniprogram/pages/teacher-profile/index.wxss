.teacher-banner {
  display: flex;
  padding: 30rpx;
  align-items: center;
  background: var(--app-soft);
  border: 1rpx solid #d9eeff;
  border-radius: 20rpx;
  gap: 22rpx;
}

.teacher-banner__icon {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: none;
  font-size: 40rpx;
}

.teacher-banner__title,
.teacher-banner__text,
.readonly-value,
.field-hint,
.character-count {
  display: block;
}

.teacher-banner__title {
  font-size: 30rpx;
  font-weight: 600;
}

.teacher-banner__text {
  margin-top: 8rpx;
  color: var(--app-muted);
  font-size: 22rpx;
}

.readonly-value {
  color: var(--app-ink);
  font-size: 30rpx;
}

.field-hint,
.character-count {
  color: var(--app-muted);
  font-size: 21rpx;
}

.field-hint {
  margin-top: 8rpx;
}

.character-count {
  margin-top: 10rpx;
  text-align: right;
}
