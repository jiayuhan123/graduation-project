.login-page {
  min-height: 100vh;
  padding: 60rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}
.login-hero {
  display: flex;
  margin-bottom: 48rpx;
  flex-direction: column;
  align-items: flex-start;
}
.brand-mark {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  margin-bottom: 28rpx;
  align-items: center;
  justify-content: center;
  background: var(--app-primary);
  border-radius: 16rpx;
  color: #fff;
}
.brand-mark__symbol {
  font-family: Georgia, serif;
  font-size: 52rpx;
  line-height: 1;
}
.login-hero__title {
  color: var(--app-ink);
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}
.login-hero__subtitle {
  margin-top: 14rpx;
  color: var(--app-muted);
  font-size: 27rpx;
}
.login-card__heading {
  padding: 30rpx 28rpx 20rpx;
}
.login-card__title,
.login-card__description {
  display: block;
}
.login-card__title {
  color: var(--app-ink);
  font-size: 32rpx;
  font-weight: 600;
}
.login-card__description {
  margin-top: 8rpx;
  color: var(--app-muted);
  font-size: 23rpx;
}
.login-mode {
  display: flex;
  margin: 0 28rpx 8rpx;
  border-bottom: 1rpx solid var(--app-line);
}
.login-mode__item {
  width: 50%;
  min-height: 88rpx;
  padding: 24rpx 0;
  border-bottom: 4rpx solid transparent;
  color: var(--app-muted);
  font-size: 26rpx;
  text-align: center;
}
.login-mode__item--active {
  border-bottom-color: var(--app-primary);
  color: var(--app-primary);
  font-weight: 600;
}
.input-placeholder {
  color: #9ba59c;
}
.picker-row {
  display: flex;
  border-top: 1rpx solid var(--app-line);
}
.picker-row__item {
  width: 50%;
  padding: 24rpx 28rpx;
}
.picker-row__item + .picker-row__item {
  border-left: 1rpx solid var(--app-line);
}
.picker-value {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  justify-content: space-between;
  color: var(--app-ink);
  font-size: 28rpx;
}
.login-action {
  margin-top: 32rpx;
}
.login-notes {
  display: flex;
  margin-top: 24rpx;
  flex-direction: column;
  align-items: center;
  color: var(--app-muted);
  font-size: 22rpx;
  line-height: 1.8;
  text-align: center;
}
