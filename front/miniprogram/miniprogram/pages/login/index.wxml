<view class="app-page login-page">
  <view class="login-hero">
    <view class="brand-mark">
      <text class="brand-mark__symbol">π</text>
    </view>
    <text class="login-hero__title">数学成长空间</text>
    <text class="login-hero__subtitle">每天，学会一点点。</text>
  </view>

  <view class="surface-card login-card">
    <view class="login-card__heading">
      <text class="login-card__title">登录账号</text>
      <text class="login-card__description">欢迎回来，继续你的数学学习。</text>
    </view>

    <view class="login-mode">
      <view
        class="login-mode__item {{loginMode === 'wechat' ? 'login-mode__item--active' : ''}}"
        data-mode="wechat"
        bindtap="switchLoginMode"
      >
        微信登录
      </view>
      <view
        class="login-mode__item {{loginMode === 'password' ? 'login-mode__item--active' : ''}}"
        data-mode="password"
        bindtap="switchLoginMode"
      >
        账号登录
      </view>
    </view>

    <block wx:if="{{loginMode === 'wechat'}}">
      <view class="field">
        <text class="field__label">昵称（选填）</text>
        <input
          class="field__control"
          maxlength="50"
          placeholder="例如：小明"
          placeholder-class="input-placeholder"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="field">
        <text class="field__label">真实姓名（选填）</text>
        <input
          class="field__control"
          maxlength="50"
          placeholder="便于老师识别"
          placeholder-class="input-placeholder"
          value="{{realName}}"
          bindinput="onRealNameInput"
        />
      </view>

      <view class="picker-row">
        <picker
          class="picker-row__item"
          mode="selector"
          range="{{grades}}"
          value="{{gradeIndex}}"
          bindchange="onGradeChange"
        >
          <text class="field__label">首次登录年级</text>
          <view class="picker-value">
            <text>{{grades[gradeIndex]}}</text>
            <t-icon name="chevron-down" size="36rpx" color="#8a8f98" />
          </view>
        </picker>

        <picker
          class="picker-row__item"
          mode="selector"
          range="{{semesters}}"
          value="{{semesterIndex}}"
          bindchange="onSemesterChange"
        >
          <text class="field__label">学期</text>
          <view class="picker-value">
            <text>{{semesters[semesterIndex]}}</text>
            <t-icon name="chevron-down" size="36rpx" color="#8a8f98" />
          </view>
        </picker>
      </view>
    </block>

    <block wx:else>
      <view class="field">
        <text class="field__label">用户名 / 手机号 / 邮箱</text>
        <input
          class="field__control"
          maxlength="254"
          placeholder="请输入登录账号"
          placeholder-class="input-placeholder"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>
      <view class="field">
        <text class="field__label">密码</text>
        <input
          class="field__control"
          password
          maxlength="72"
          placeholder="请输入密码"
          placeholder-class="input-placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </block>
  </view>

  <view class="login-action">
    <t-button
      block
      size="large"
      shape="rectangle"
      theme="primary"
      loading="{{submitting}}"
      bind:tap="handleLogin"
    >
      {{loginMode === 'wechat' ? '微信一键登录' : '登录'}}
    </t-button>
  </view>

  <view class="login-notes">
    <text wx:if="{{loginMode === 'wechat'}}">首次微信登录会自动创建学生身份</text>
    <text wx:else>教师和管理员请使用已分配的账号</text>
  </view>
</view>
