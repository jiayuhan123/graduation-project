<view class="app-page page-shell home-page">
  <view wx:if="{{loading}}" class="page-loading">
    <t-loading theme="circular" size="48rpx" text="正在加载" />
  </view>
  <block wx:else>
    <view class="home-heading">
      <view class="home-heading__main">
        <text class="home-heading__eyebrow">{{dateLabel}} · {{greeting}}</text>
        <text class="home-heading__title">{{displayName}}，你好</text>
        <text class="home-heading__subtitle">{{identityLine}}</text>
      </view>
      <view
        class="mini-avatar"
        bindtap="openProfile"
        hover-class="pressable"
        aria-role="button"
        aria-label="个人中心"
      >
        <image
          wx:if="{{avatarUrl}}"
          class="mini-avatar__image"
          src="{{avatarUrl}}"
          mode="aspectFill"
        />
        <text wx:else>{{avatarText}}</text>
      </view>
    </view>
    <scroll-view
      wx:if="{{roleOptions.length > 1}}"
      class="role-switch"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view
        wx:for="{{roleOptions}}"
        wx:key="code"
        class="role-chip {{item.code === activeRole ? 'role-chip--active' : ''}}"
        data-role="{{item.code}}"
        bindtap="switchRole"
        hover-class="pressable"
      >
        <t-icon name="{{item.icon}}" size="28rpx" />
        <text>{{item.label}}</text>
      </view>
    </scroll-view>
    <block wx:if="{{isStudentRole}}">
      <view
        class="study-feature"
        bindtap="openPractice"
        hover-class="pressable"
        aria-role="button"
        aria-label="开始自主练习"
      >
        <view class="study-feature__copy">
          <text class="study-feature__label">每日练习</text>
          <text class="study-feature__title">
            把数学，
            <text class="feature-line">一点点学明白。</text>
          </text>
          <text class="study-feature__description">选好知识点，今天也进步一点。</text>
          <view class="study-feature__action">
            <text>开始练习</text>
            <t-icon name="arrow-right" size="32rpx" />
          </view>
        </view>
        <view class="math-paper" aria-hidden="true">
          <text class="math-paper__heading">数学练习</text>
          <text class="math-paper__equation">12 + 8</text>
          <view class="math-paper__answer">
            <text>= 20</text>
            <text class="math-paper__check">✓</text>
          </view>
          <view class="math-paper__line"></view>
          <view class="math-paper__line math-paper__line--short"></view>
        </view>
      </view>
      <view class="home-shortcuts">
        <view class="home-shortcut" bindtap="openTeachingAssignments" hover-class="pressable">
          <t-icon name="edit-1" size="40rpx" />
          <text class="home-shortcut__title">我的作业</text>
          <text class="home-shortcut__note">老师布置的练习</text>
        </view>
        <view class="home-shortcut" bindtap="openErrors" hover-class="pressable">
          <t-icon name="root-list" size="40rpx" />
          <text class="home-shortcut__title">错题本</text>
          <text class="home-shortcut__note">再想一遍就懂了</text>
        </view>
        <view class="home-shortcut" bindtap="openPhotoMarking" hover-class="pressable">
          <t-icon name="camera" size="40rpx" />
          <text class="home-shortcut__title">拍照批改</text>
          <text class="home-shortcut__note">整理纸上的练习</text>
        </view>
      </view>
      <view class="section-bar">
        <text class="section-bar__title">学习有迹可循</text>
        <button class="text-action" bindtap="openLearning">
          学习记录
          <t-icon name="chevron-right" size="26rpx" />
        </button>
      </view>
      <view class="surface-card progress-note" bindtap="openLearning" hover-class="pressable">
        <view class="progress-note__symbol"><t-icon name="chart" size="42rpx" /></view>
        <view class="entry-main">
          <text class="entry-title">每一份认真，都算数</text>
          <text class="entry-description">看看最近的练习，找到下一步的方向。</text>
        </view>
        <t-icon name="chevron-right" size="30rpx" color="#9ca69d" />
      </view>
      <view class="section-bar"><text class="section-bar__title">课后再练一练</text></view>
      <view class="surface-card">
        <view class="entry-row" bindtap="openRecommendations" hover-class="pressable">
          <view class="entry-icon"><t-icon name="lightbulb" size="36rpx" /></view>
          <view class="entry-main">
            <text class="entry-title">巩固练习</text>
            <text class="entry-description">从还不熟练的知识点开始</text>
          </view>
          <t-icon class="entry-arrow" name="chevron-right" size="30rpx" />
        </view>
        <view class="entry-row" bindtap="openPk" hover-class="pressable">
          <view class="entry-icon"><t-icon name="gamepad" size="36rpx" /></view>
          <view class="entry-main">
            <text class="entry-title">双人 PK</text>
            <text class="entry-description">和朋友来一场数学挑战</text>
          </view>
          <t-icon class="entry-arrow" name="chevron-right" size="30rpx" />
        </view>
      </view>
    </block>
    <block wx:elif="{{isTeacherRole}}">
      <view class="work-feature">
        <text class="study-feature__label">教学日常</text>
        <text class="work-feature__title">
          备好每一课，
          <text class="feature-line">看见每个孩子的进步。</text>
        </text>
        <text class="study-feature__description">班级、作业和学生反馈，安排得井井有条。</text>
        <button class="work-feature__button" bindtap="openTeachingAssignments">
          布置与管理作业
          <t-icon name="arrow-right" size="30rpx" />
        </button>
      </view>
      <view class="section-bar"><text class="section-bar__title">今天的教学</text></view>
      <view class="surface-card">
        <view class="entry-row" bindtap="openClassroom" hover-class="pressable">
          <view class="entry-icon"><t-icon name="usergroup" size="36rpx" /></view>
          <view class="entry-main">
            <text class="entry-title">我的班级</text>
            <text class="entry-description">班级动态与学生名单</text>
          </view>
          <t-icon class="entry-arrow" name="chevron-right" size="30rpx" />
        </view>
        <view class="entry-row" bindtap="openTeachingSubmissions" hover-class="pressable">
          <view class="entry-icon"><t-icon name="check-circle" size="36rpx" /></view>
          <view class="entry-main">
            <text class="entry-title">查看学生提交</text>
            <text class="entry-description">了解作答情况，留下针对性的评语</text>
          </view>
          <t-icon class="entry-arrow" name="chevron-right" size="30rpx" />
        </view>
        <view class="entry-row" bindtap="openLearning" hover-class="pressable">
          <view class="entry-icon"><t-icon name="edit-1" size="36rpx" /></view>
          <view class="entry-main">
            <text class="entry-title">教学工作台</text>
            <text class="entry-description">查看最近的作业安排</text>
          </view>
          <t-icon class="entry-arrow" name="chevron-right" size="30rpx" />
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="page-intro">
        <text class="page-intro__kicker">{{activeRoleLabel}}</text>
        <text class="page-intro__title">把日常事务，安排妥当。</text>
        <text class="page-intro__description">在这里管理平台账号与角色。</text>
      </view>
      <view class="surface-card">
        <t-cell
          wx:if="{{isAdminRole && canManageUsers}}"
          title="用户目录"
          description="搜索账号，查看身份与状态"
          left-icon="usergroup"
          arrow
          bind:click="openAdminUsers"
        />
        <t-cell
          wx:if="{{isAdminRole && canManageRoles}}"
          title="角色与权限"
          description="查看角色和权限分配"
          left-icon="secured"
          arrow
          bind:click="openAdminRoles"
        />
        <t-cell
          title="账号安全"
          description="密码与微信绑定"
          left-icon="lock-on"
          arrow
          bind:click="openSecurity"
        />
        <t-cell title="个人资料" left-icon="user" arrow bind:click="openProfile" />
      </view>
    </block>
    <text class="home-footer">数学成长空间 · 慢慢学，稳稳向前</text>
  </block>
</view>
