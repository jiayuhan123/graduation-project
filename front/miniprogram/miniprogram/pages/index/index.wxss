.home-heading {
  display: flex;
  padding: 16rpx 0 20rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.feature-line {
  display: block;
}
.home-heading__main {
  min-width: 0;
  flex: 1;
}
.home-heading__eyebrow,
.home-heading__title,
.home-heading__subtitle {
  display: block;
}
.home-heading__eyebrow {
  color: var(--app-muted);
  font-size: 23rpx;
}
.home-heading__title {
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--app-ink);
  font-size: 42rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.home-heading__subtitle {
  margin-top: 10rpx;
  color: var(--app-muted);
  font-size: 23rpx;
}
.mini-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #e3e9dd;
  border: 4rpx solid #fff;
  border-radius: 50%;
  color: var(--app-primary);
  font-size: 32rpx;
  font-weight: 500;
}
.mini-avatar__image {
  width: 100%;
  height: 100%;
}
.study-feature {
  position: relative;
  display: flex;
  min-height: 360rpx;
  margin-top: 30rpx;
  padding: 36rpx 32rpx;
  align-items: center;
  overflow: hidden;
  background: #e8edde;
  border: 1rpx solid #dce3d4;
  border-radius: 22rpx;
}
.study-feature__copy {
  position: relative;
  z-index: 1;
  width: 64%;
}
.study-feature__label,
.study-feature__title,
.study-feature__description {
  display: block;
}
.study-feature__label {
  color: #5a735b;
  font-size: 23rpx;
}
.study-feature__title {
  margin-top: 20rpx;
  color: #294333;
  font-size: 43rpx;
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: -1rpx;
}
.study-feature__description {
  margin-top: 16rpx;
  color: #6a7a65;
  font-size: 23rpx;
  line-height: 1.65;
}
.study-feature__action {
  display: inline-flex;
  min-height: 76rpx;
  margin-top: 28rpx;
  padding: 16rpx 24rpx;
  align-items: center;
  gap: 28rpx;
  background: #285c49;
  border-radius: 12rpx;
  color: #fff;
  font-size: 25rpx;
}
.math-paper {
  position: absolute;
  top: 72rpx;
  right: -14rpx;
  width: 228rpx;
  height: 264rpx;
  padding: 28rpx;
  transform: rotate(9deg);
  background: #fffdf4;
  border: 1rpx solid #d9decd;
  border-radius: 8rpx;
  color: #44614b;
}
.math-paper__heading {
  display: block;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e0e4d7;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}
.math-paper__equation {
  display: block;
  margin-top: 20rpx;
  font-family: Georgia, serif;
  font-size: 34rpx;
}
.math-paper__answer {
  display: flex;
  margin-top: 6rpx;
  align-items: center;
  gap: 30rpx;
  font-family: Georgia, serif;
  font-size: 34rpx;
}
.math-paper__check {
  color: #a46f48;
  font-size: 44rpx;
}
.math-paper__line {
  height: 1rpx;
  margin-top: 22rpx;
  background: #dfe4d8;
}
.math-paper__line--short {
  width: 65%;
  margin-top: 20rpx;
}
.home-shortcuts {
  display: flex;
  padding: 34rpx 0 26rpx;
  border-bottom: 1rpx solid var(--app-line);
}
.home-shortcut {
  display: flex;
  width: 33.333%;
  min-height: 132rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #52705f;
}
.home-shortcut + .home-shortcut {
  border-left: 1rpx solid var(--app-line);
}
.home-shortcut__title {
  margin-top: 14rpx;
  color: var(--app-ink);
  font-size: 26rpx;
  font-weight: 500;
}
.home-shortcut__note {
  margin-top: 7rpx;
  color: var(--app-muted);
  font-size: 20rpx;
}
.progress-note {
  display: flex;
  padding: 28rpx;
  align-items: center;
  gap: 22rpx;
}
.progress-note__symbol {
  display: flex;
  width: 72rpx;
  height: 84rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #9b7951;
}
.home-footer {
  display: block;
  padding-top: 42rpx;
  color: #939a90;
  font-size: 21rpx;
  text-align: center;
}
.work-feature {
  margin-top: 32rpx;
  padding: 36rpx 32rpx;
  background: #e8edde;
  border-radius: 20rpx;
}
.work-feature__title {
  display: block;
  margin-top: 20rpx;
  color: var(--app-ink);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.5;
}
.work-feature__button {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  margin: 30rpx 0 0;
  padding: 16rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  background: var(--app-primary);
  border-radius: 12rpx;
  color: #fff;
  font-size: 27rpx;
  line-height: 1.5;
}
