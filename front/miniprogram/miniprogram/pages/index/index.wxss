.home-heading {
  display: flex;
  padding: 8rpx 4rpx 32rpx;
  align-items: center;
  justify-content: space-between;
}

.home-heading__eyebrow,
.home-heading__title {
  display: block;
}

.home-heading__eyebrow {
  color: #8a8f98;
  font-size: 24rpx;
}

.home-heading__title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.mini-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(135deg, #ffad73, #ff7a2a);
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 42, 0.22);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.mini-avatar__image {
  width: 100%;
  height: 100%;
}

.identity-card {
  position: relative;
  padding: 34rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #ffffff, #fff8f2);
}

.identity-card__glow {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 138, 61, 0.1);
  border-radius: 50%;
}

.identity-card__top {
  position: relative;
  display: flex;
  align-items: center;
  gap: 26rpx;
}

.identity-card__icon {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.08);
  font-size: 50rpx;
}

.identity-card__content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.identity-card__label,
.identity-card__role,
.identity-card__line {
  display: block;
}

.identity-card__label {
  color: #8a8f98;
  font-size: 22rpx;
}

.identity-card__role {
  margin-top: 5rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.identity-card__line {
  margin-top: 8rpx;
  color: #636e72;
  font-size: 24rpx;
}

.identity-card__footer {
  position: relative;
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f0f2f5;
  color: #636e72;
  font-size: 23rpx;
}

.section-heading--compact {
  display: block;
  margin-bottom: 0;
}

.role-switch {
  width: 100%;
}

.role-switch .role-chip {
  display: inline-flex;
  margin-right: 16rpx;
}

.menu-card {
  --td-cell-bg-color: transparent;
}

.status-grid {
  display: flex;
  padding: 30rpx 12rpx;
}

.status-item {
  display: flex;
  width: 33.333%;
  flex-direction: column;
  align-items: center;
}

.status-item + .status-item {
  border-left: 1rpx solid #f0f2f5;
}

.status-item__value,
.status-item__label {
  display: block;
}

.status-item__value {
  color: #2d3436;
  font-size: 30rpx;
  font-weight: 750;
}

.status-item__label {
  margin-top: 8rpx;
  color: #8a8f98;
  font-size: 22rpx;
}

.admin-note {
  display: flex;
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  background: #f2f7ff;
  border-radius: 24rpx;
  gap: 18rpx;
}

.admin-note__icon {
  font-size: 36rpx;
}

.admin-note__title,
.admin-note__text {
  display: block;
}

.admin-note__title {
  color: #34495e;
  font-size: 26rpx;
  font-weight: 650;
}

.admin-note__text {
  margin-top: 6rpx;
  color: #718096;
  font-size: 22rpx;
  line-height: 1.55;
}
