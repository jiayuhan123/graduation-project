.directory-summary {
  display: flex;
  padding: 30rpx;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff3eb, #ffffff);
  border: 1rpx solid #ffe3d0;
  border-radius: 30rpx;
}

.directory-summary__title,
.directory-summary__text {
  display: block;
}

.directory-summary__title {
  font-size: 34rpx;
  font-weight: 750;
}

.directory-summary__text {
  margin-top: 8rpx;
  color: #7b8289;
  font-size: 23rpx;
}

.directory-summary__icon {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 24rpx;
  font-size: 38rpx;
}

.search-row {
  display: flex;
  margin-top: 26rpx;
  align-items: center;
  gap: 14rpx;
}

.search-box {
  display: flex;
  min-width: 0;
  height: 80rpx;
  padding: 0 22rpx;
  flex: 1;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #eceff2;
  border-radius: 24rpx;
  gap: 12rpx;
}

.search-box__input {
  min-width: 0;
  flex: 1;
  font-size: 25rpx;
}

.filter-button {
  display: flex;
  height: 80rpx;
  padding: 0 20rpx;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #eceff2;
  border-radius: 24rpx;
  color: #636e72;
  font-size: 23rpx;
  gap: 6rpx;
}

.user-list {
  margin-top: 24rpx;
}

.user-card {
  display: flex;
  margin-bottom: 18rpx;
  padding: 26rpx;
  align-items: center;
}

.user-card__avatar {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(135deg, #ffad73, #ff7a2a);
  border-radius: 25rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 700;
}

.user-card__avatar-image {
  width: 100%;
  height: 100%;
}

.user-card__content {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.user-card__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-card__name {
  max-width: 260rpx;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-card__username,
.user-card__roles {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #8a8f98;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wechat-dot {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  margin-left: 12rpx;
  align-items: center;
  justify-content: center;
  background: #e8f8ef;
  border-radius: 50%;
  color: #07a94f;
  font-size: 19rpx;
  font-weight: 700;
}

.load-more {
  display: flex;
  padding: 22rpx 0;
  justify-content: center;
}

.list-end {
  display: block;
  padding: 24rpx 0;
  color: #a0a6ad;
  font-size: 22rpx;
  text-align: center;
}
