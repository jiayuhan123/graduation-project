.role-banner {
  display: flex;
  padding: 30rpx;
  align-items: center;
  background: var(--app-soft);
  border: 1rpx solid #dfeaff;
  border-radius: 20rpx;
  gap: 22rpx;
}

.role-banner__icon {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 20rpx;
  font-size: 38rpx;
}

.role-banner__title,
.role-banner__text,
.role-card__code,
.role-card__description,
.role-card__empty {
  display: block;
}

.role-banner__title {
  font-size: 32rpx;
  font-weight: 600;
}

.role-banner__text {
  margin-top: 8rpx;
  color: var(--app-muted);
  font-size: 22rpx;
}

.role-list {
  margin-top: 26rpx;
}

.role-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.role-card__heading,
.role-card__name-row {
  display: flex;
  align-items: center;
}

.role-card__heading {
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
}

.role-card__name-row {
  gap: 10rpx;
  flex-wrap: wrap;
}

.role-card__name {
  overflow-wrap: anywhere;
  font-size: 30rpx;
  font-weight: 600;
}

.role-card__code {
  margin-top: 6rpx;
  color: var(--app-muted);
  font-size: 21rpx;
}

.role-card__count {
  color: var(--app-primary);
  font-size: 22rpx;
  font-weight: 650;
}

.role-card__description {
  margin-top: 20rpx;
  color: #636e72;
  font-size: 23rpx;
  line-height: 1.55;
}

.permission-list {
  display: flex;
  margin-top: 20rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.permission-pill {
  padding: 10rpx 16rpx;
  background: #f6f7f9;
  border-radius: 12rpx;
  color: #596168;
  font-size: 21rpx;
}

.role-card__empty {
  color: var(--app-muted);
  font-size: 22rpx;
}
