<view class="app-page page-shell">
  <view wx:if="{{loading}}" class="page-loading">
    <t-loading theme="circular" size="52rpx" text="正在加载个人资料" />
  </view>

  <block wx:elif="{{profile}}">
    <view class="profile-card">
      <view class="profile-card__avatar">
        <image
          wx:if="{{avatarUrl}}"
          class="profile-card__avatar-image"
          src="{{avatarUrl}}"
          mode="aspectFill"
        />
        <text wx:else>{{avatarText}}</text>
      </view>
      <view class="profile-card__main">
        <view class="profile-card__name-row">
          <text class="profile-card__name">{{displayName}}</text>
          <t-tag theme="primary" variant="light" shape="square" size="small">
            {{activeRoleLabel}}
          </t-tag>
        </view>
        <text class="profile-card__username">账号 {{profile.username}}</text>
        <text class="profile-card__binding">
          {{profile.wechatBound ? '微信身份已绑定' : '微信身份未绑定'}}
        </text>
      </view>
      <view
        class="profile-card__edit"
        bindtap="openEditProfile"
        hover-class="pressable"
        aria-role="button"
        aria-label="编辑资料"
      >
        <t-icon name="chevron-right" size="36rpx" color="#285c49" />
      </view>
    </view>

    <view wx:if="{{roleOptions.length > 1}}">
      <text class="section-heading section-heading--compact">当前查看身份</text>
      <scroll-view class="role-switch" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{roleOptions}}"
          wx:key="code"
          class="role-chip {{item.code === activeRole ? 'role-chip--active' : ''}}"
          data-role="{{item.code}}"
          bindtap="switchRole"
        >
          <t-icon name="{{item.icon}}" size="28rpx" />
          <text>{{item.label}}</text>
        </view>
      </scroll-view>
    </view>

    <text class="section-heading">身份资料</text>
    <view class="surface-card">
      <block wx:if="{{activeRole === 'student'}}">
        <t-cell
          title="学生资料"
          description="{{studentSummary}}"
          left-icon="education"
          arrow
          bind:click="openStudentProfile"
        />
      </block>
      <block wx:elif="{{activeRole === 'teacher'}}">
        <t-cell
          title="教师资料"
          description="{{teacherSummary}}"
          left-icon="root-list"
          arrow
          bind:click="openTeacherProfile"
        />
      </block>
      <block wx:elif="{{activeRole === 'admin'}}">
        <view class="admin-identity">
          <view class="admin-identity__icon">
            <t-icon name="secured" size="40rpx" color="#52705f" />
          </view>
          <view>
            <text class="admin-identity__title">平台管理员</text>
            <text class="admin-identity__description">
              当前账号拥有 {{profile.permissions.length}} 项有效权限
            </text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="admin-identity">
          <view class="admin-identity__icon">
            <t-icon name="user" size="40rpx" color="#52705f" />
          </view>
          <view>
            <text class="admin-identity__title">{{activeRoleLabel}}</text>
            <text class="admin-identity__description">自定义角色身份</text>
          </view>
        </view>
      </block>
    </view>

    <view class="section-bar">
      <text class="section-bar__title">账号信息</text>
      <button class="text-action" bindtap="toggleAccountInfo">
        {{showAccountInfo ? '收起' : '查看详情'}}
        <t-icon name="{{showAccountInfo ? 'chevron-up' : 'chevron-down'}}" size="28rpx" />
      </button>
    </view>
    <view wx:if="{{showAccountInfo}}" class="surface-card">
      <t-cell title="姓名" note="{{profile.realName || '未填写'}}" />
      <t-cell title="手机号" note="{{profile.phone || '未绑定'}}" />
      <t-cell title="邮箱" note="{{profile.email || '未绑定'}}" />
      <t-cell title="加入时间" note="{{joinedAt}}" />
      <t-cell title="最近登录" note="{{lastLoginAt}}" />
    </view>

    <text class="section-heading">账号设置</text>
    <view class="surface-card">
      <t-cell title="编辑个人资料" left-icon="user-setting" arrow bind:click="openEditProfile" />
      <t-cell title="账号与密码" left-icon="lock-on" arrow bind:click="openSecurity" />
    </view>

    <view class="logout-action">
      <t-button
        block
        theme="default"
        variant="base"
        shape="rectangle"
        loading="{{loggingOut}}"
        bind:tap="handleLogout"
      >
        退出登录
      </t-button>
    </view>
  </block>

  <view wx:else class="empty-state">
    <t-empty description="暂时无法加载个人资料" />
  </view>
</view>
