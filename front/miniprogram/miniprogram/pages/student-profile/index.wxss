.student-banner {
  display: flex;
  padding: 30rpx;
  align-items: center;
  background: var(--app-soft);
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
  gap: 22rpx;
}

.student-banner__icon {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: none;
  font-size: 40rpx;
}

.student-banner__title,
.student-banner__text,
.readonly-value,
.field-hint,
.picker-field__value {
  display: block;
}

.student-banner__title {
  font-size: 30rpx;
  font-weight: 600;
}

.student-banner__text {
  margin-top: 8rpx;
  color: var(--app-muted);
  font-size: 22rpx;
}

.readonly-value,
.picker-field__value {
  color: var(--app-ink);
  font-size: 30rpx;
}

.field-hint {
  margin-top: 8rpx;
  color: var(--app-muted);
  font-size: 21rpx;
}

.picker-field {
  display: flex;
  padding: 24rpx 28rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--app-line);
}

.picker-field--last {
  border-bottom: 0;
}
