.student-banner {
  display: flex;
  padding: 30rpx;
  align-items: center;
  background: linear-gradient(135deg, #fff3eb, #ffffff);
  border: 1rpx solid #ffe3d0;
  border-radius: 30rpx;
  gap: 22rpx;
}

.student-banner__icon {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 61, 0.12);
  font-size: 40rpx;
}

.student-banner__title,
.student-banner__text,
.readonly-value,
.field-hint,
.picker-field__value {
  display: block;
}

.student-banner__title {
  font-size: 30rpx;
  font-weight: 750;
}

.student-banner__text {
  margin-top: 8rpx;
  color: #7b8289;
  font-size: 22rpx;
}

.readonly-value,
.picker-field__value {
  color: #2d3436;
  font-size: 30rpx;
}

.field-hint {
  margin-top: 8rpx;
  color: #a0a6ad;
  font-size: 21rpx;
}

.picker-field {
  display: flex;
  padding: 24rpx 28rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0f2f5;
}

.picker-field--last {
  border-bottom: 0;
}
