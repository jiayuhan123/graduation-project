.page-heading {
  padding: 10rpx 4rpx 26rpx;
}
.page-heading__eyebrow,
.page-heading__title,
.page-heading__description {
  display: block;
}
.page-heading__eyebrow {
  color: #ef752f;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}
.page-heading__title {
  margin-top: 8rpx;
  color: #2d3436;
  font-size: 42rpx;
  font-weight: 900;
}
.page-heading__description {
  margin-top: 10rpx;
  color: #818990;
  font-size: 24rpx;
  line-height: 1.65;
}
.state {
  display: grid;
  min-height: 400rpx;
  place-items: center;
}
.session-list {
  display: grid;
  gap: 18rpx;
}
.session-card {
  display: flex;
  padding: 26rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.session-card__title,
.session-card__meta,
.session-card__result text {
  display: block;
}
.session-card__title {
  color: #2d3436;
  font-size: 28rpx;
  font-weight: 750;
}
.session-card__meta {
  margin-top: 8rpx;
  color: #858d93;
  font-size: 22rpx;
}
.session-card__result {
  text-align: right;
}
.session-card__result text {
  max-width: 260rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #9a9fa3;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
