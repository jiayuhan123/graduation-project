.state {
  display: grid;
  min-height: 70vh;
  place-items: center;
}
.rating-card {
  padding: 42rpx 34rpx;
  background: linear-gradient(145deg, #302b3d, #594267);
  border-radius: 30rpx;
  color: #fff;
  text-align: center;
}
.rating-card__label,
.rating-card__value,
.rating-card__meta {
  display: block;
}
.rating-card__label {
  color: #ffbd91;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
.rating-card__value {
  margin-top: 10rpx;
  font-size: 68rpx;
  font-weight: 950;
}
.rating-card__meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}
.stats-grid {
  display: grid;
  margin-top: 20rpx;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.stats-grid view {
  display: flex;
  padding: 28rpx;
  flex-direction: column;
  align-items: center;
}
.stats-grid strong {
  color: #2d3436;
  font-size: 38rpx;
}
.stats-grid text {
  margin-top: 7rpx;
  color: #858d93;
  font-size: 22rpx;
}
.reward-card {
  margin-top: 20rpx;
  padding: 28rpx;
}
.section-header,
.reward-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-header strong {
  font-size: 29rpx;
}
.section-header text {
  color: #e66e2c;
  font-size: 23rpx;
}
.reward-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef0f2;
  color: #626a70;
  font-size: 23rpx;
}
.reward-row strong {
  color: #e66e2c;
}
.empty {
  display: block;
  padding: 50rpx 0;
  color: #92989c;
  font-size: 23rpx;
  text-align: center;
}
