<view class="app-page page-shell submission-page">
  <view wx:if="{{loading}}" class="page-loading">
    <t-loading theme="circular" size="52rpx" text="正在加载提交记录" />
  </view>
  <block wx:else>
    <view class="submission-hero">
      <text class="submission-hero__eyebrow">作业记录</text>
      <text class="submission-hero__title">{{isTeacher ? '学生提交' : '提交记录'}}</text>
      <text class="submission-hero__description">
        {{isTeacher ? '查看学生进度和成绩，并维护教师评语。' : '查看作业分配、作答和批改状态。'}}
      </text>
    </view>
    <view wx:if="{{isTeacher && assignments.length}}" class="surface-card assignment-picker">
      <text>当前作业</text>
      <picker
        range="{{assignments}}"
        range-key="title"
        value="{{assignmentIndex}}"
        bindchange="selectAssignment"
      >
        <view>{{assignments[assignmentIndex].title}}</view>
      </picker>
    </view>

    <view wx:if="{{isTeacher && submissions.length}}" class="submission-list">
      <view wx:for="{{submissions}}" wx:key="submission.id" class="surface-card submission-card">
        <view class="submission-card__top">
          <view>
            <text class="submission-card__name">
              {{item.displayName || item.username || item.submission.studentId}}
            </text>
            <text class="submission-card__meta">
              {{item.submission.layerCode}} 层 · {{item.username || '暂无用户名'}}
            </text>
          </view>
          <t-tag
            theme="{{item.submission.status === 'GRADED' ? 'success' : 'warning'}}"
            variant="light"
          >
            {{item.submission.status === 'DRAFT' ? '草稿' : item.submission.status === 'PUBLISHED' ?
            '已发布' : item.submission.status === 'CLOSED' ? '已结束' : item.submission.status ===
            'GRADED' ? '已批改' : item.submission.status === 'IN_PROGRESS' ? '进行中' :
            item.submission.status === 'SUBMITTED' ? '已提交' : item.submission.status === 'OVERDUE'
            ? '已逾期' : item.submission.status === 'CANCELLED' ? '已取消' : '待完成'}}
          </t-tag>
        </view>
        <view class="score-line">
          <text>{{item.submission.score === null ? '—' : item.submission.score}}</text>
          <text>
            {{item.submission.totalCount ? item.submission.correctCount + '/' +
            item.submission.totalCount + ' 题正确' : '尚未评分'}}
          </text>
        </view>
        <textarea
          class="comment-input"
          value="{{comments[item.submission.id]}}"
          maxlength="500"
          placeholder="给学生写一句评语（选填）"
          data-id="{{item.submission.id}}"
          bindinput="onCommentInput"
        />
        <view class="comment-action">
          <t-button
            size="small"
            variant="outline"
            data-id="{{item.submission.id}}"
            bind:tap="saveComment"
          >
            保存评语
          </t-button>
        </view>
      </view>
    </view>

    <view wx:elif="{{!isTeacher && studentAssignments.length}}" class="submission-list">
      <view wx:for="{{studentAssignments}}" wx:key="index" class="surface-card submission-card">
        <view class="submission-card__top">
          <view>
            <text class="submission-card__name">{{item.assignment.title}}</text>
            <text class="submission-card__meta">
              {{item.submission.layerCode}} 层 · 截止 {{item.assignment.dueAt}}
            </text>
          </view>
          <t-tag
            theme="{{item.submission.status === 'GRADED' ? 'success' : 'warning'}}"
            variant="light"
          >
            {{item.submission.status === 'DRAFT' ? '草稿' : item.submission.status === 'PUBLISHED' ?
            '已发布' : item.submission.status === 'CLOSED' ? '已结束' : item.submission.status ===
            'GRADED' ? '已批改' : item.submission.status === 'IN_PROGRESS' ? '进行中' :
            item.submission.status === 'SUBMITTED' ? '已提交' : item.submission.status === 'OVERDUE'
            ? '已逾期' : item.submission.status === 'CANCELLED' ? '已取消' : '待完成'}}
          </t-tag>
        </view>
        <view class="score-line">
          <text>{{item.submission.score === null ? '—' : item.submission.score}}</text>
          <text>
            {{item.submission.totalCount ? item.submission.correctCount + '/' +
            item.submission.totalCount + ' 题正确' : '尚未评分'}}
          </text>
        </view>
        <text wx:if="{{item.submission.teacherComment}}" class="teacher-comment">
          教师评语：{{item.submission.teacherComment}}
        </text>
      </view>
    </view>

    <view wx:else class="surface-card empty-state">
      <t-empty description="{{isTeacher ? '当前作业暂无学生记录' : '暂无提交记录'}}" />
    </view>
  </block>
</view>
