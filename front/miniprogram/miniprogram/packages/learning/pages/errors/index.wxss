.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
  box-sizing: border-box;
}
.hero {
  padding: 20rpx 6rpx 28rpx;
}
.title {
  display: block;
  color: var(--app-ink);
  font-size: 46rpx;
  font-weight: 600;
}
.description {
  display: block;
  margin-top: 12rpx;
  color: var(--app-muted);
  font-size: 25rpx;
  line-height: 1.6;
}
.filters {
  display: flex;
  margin-bottom: 24rpx;
  gap: 14rpx;
}
.filter {
  height: 66rpx;
  margin: 0;
  padding: 0 25rpx;
  background: #fff;
  border: 0;
  border-radius: 12rpx;
  color: #697178;
  font-size: 24rpx;
  line-height: 66rpx;
}
.filter::after {
  border: 0;
}
.filter.active {
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-weight: 700;
}
.list {
  display: grid;
  gap: 18rpx;
}
.card {
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #30373b;
  font-size: 28rpx;
  font-weight: 700;
  gap: 20rpx;
}
.card-head > text:first-child {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}
.status {
  flex-shrink: 0;
  padding: 7rpx 15rpx;
  background: var(--app-primary-soft);
  border-radius: 12rpx;
  color: var(--app-primary);
  font-size: 21rpx;
}
.meta {
  display: block;
  margin-top: 12rpx;
  color: var(--app-muted);
  font-size: 22rpx;
}
.diagnosis {
  display: block;
  margin-top: 18rpx;
  color: #5c656b;
  font-size: 25rpx;
  line-height: 1.65;
}
.state {
  display: grid;
  min-height: 50vh;
  color: var(--app-muted);
  place-items: center;
}
