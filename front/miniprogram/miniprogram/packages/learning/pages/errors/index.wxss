.page { min-height: 100vh; padding: 32rpx; background: #f7f8fa; box-sizing: border-box; }
.hero { padding: 20rpx 6rpx 28rpx; }
.title { display: block; color: #2d3436; font-size: 46rpx; font-weight: 800; }
.description { display: block; margin-top: 12rpx; color: #838b92; font-size: 25rpx; line-height: 1.6; }
.filters { display: flex; margin-bottom: 24rpx; gap: 14rpx; }
.filter { height: 66rpx; margin: 0; padding: 0 25rpx; background: #fff; border: 0; border-radius: 999rpx; color: #697178; font-size: 24rpx; line-height: 66rpx; }
.filter::after { border: 0; }
.filter.active { background: #fff0e7; color: #dc621b; font-weight: 700; }
.list { display: grid; gap: 18rpx; }
.card { padding: 28rpx; background: #fff; border: 1rpx solid #eceef0; border-radius: 24rpx; }
.card-head { display: flex; align-items: center; justify-content: space-between; color: #30373b; font-size: 28rpx; font-weight: 700; }
.status { padding: 7rpx 15rpx; background: #fff0e7; border-radius: 999rpx; color: #df641d; font-size: 21rpx; }
.meta { display: block; margin-top: 12rpx; color: #92999e; font-size: 22rpx; }
.diagnosis { display: block; margin-top: 18rpx; color: #5c656b; font-size: 25rpx; line-height: 1.65; }
.state { display: grid; min-height: 50vh; color: #92999e; place-items: center; }
