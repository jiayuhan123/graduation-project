.page {
  min-height: 100vh;
  padding: 28rpx;
  background: var(--app-bg);
  box-sizing: border-box;
}
.hero {
  display: flex;
  padding: 38rpx 32rpx;
  flex-direction: column;
  background: var(--app-primary);
  border-radius: 20rpx;
  color: #fff;
  box-shadow: none;
}
.eyebrow {
  color: #9fe7d7;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.title {
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 600;
}
.description {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.65;
}
button {
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
}
button::after {
  border: 0;
}
.choose-button {
  width: 100%;
  margin-top: 28rpx;
  background: #fff;
  color: var(--app-primary);
  font-weight: 700;
}
.surface {
  background: #fff;
  border: 1rpx solid #e8edef;
  border-radius: 22rpx;
}
.preview-card {
  display: grid;
  margin-top: 20rpx;
  padding: 22rpx;
  color: #6b7479;
  font-size: 23rpx;
  gap: 18rpx;
}
.preview {
  width: 100%;
  height: 360rpx;
  background: #f0f2f3;
  border-radius: 16rpx;
}
.primary-button {
  background: var(--app-primary);
  color: #fff;
}
.detail,
.editor {
  margin-top: 28rpx;
}
.section-head {
  display: flex;
  margin: 0 6rpx 16rpx;
  align-items: center;
  justify-content: space-between;
}
.section-head text {
  display: block;
}
.section-title {
  color: #273238;
  font-size: 29rpx;
  font-weight: 600;
}
.section-tip,
.meta {
  margin-top: 5rpx;
  color: #8a949a;
  font-size: 21rpx;
}
.link {
  color: var(--app-primary);
  font-size: 24rpx;
}
.waiting {
  display: flex;
  min-height: 150rpx;
  align-items: center;
  justify-content: center;
  color: #7c878c;
  font-size: 24rpx;
  gap: 10rpx;
}
.spinner {
  color: var(--app-primary);
  font-size: 38rpx;
}
.item-list,
.task-list {
  display: grid;
  gap: 14rpx;
}
.item-card {
  display: grid;
  padding: 22rpx;
  gap: 12rpx;
}
.item-card--review {
  border-color: #f1b77c;
  box-shadow: none;
}
.item-head,
.task-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.item-title,
.task-title {
  color: #29343a;
  font-size: 26rpx;
  font-weight: 700;
}
.status {
  color: var(--app-primary);
  font-size: 22rpx;
}
.stem {
  color: #465158;
  font-size: 25rpx;
  line-height: 1.55;
}
.answer {
  padding: 14rpx;
  background: #f5f8f8;
  border-radius: 12rpx;
  color: #273238;
  font-size: 24rpx;
}
.editor {
  display: grid;
  padding: 24rpx;
  gap: 18rpx;
}
.editor label {
  display: grid;
  color: #68747a;
  font-size: 22rpx;
  gap: 8rpx;
}
.editor textarea,
.editor input {
  width: 100%;
  min-height: 76rpx;
  padding: 15rpx;
  background: var(--app-bg);
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #273238;
  font-size: 25rpx;
}
.editor textarea {
  min-height: 150rpx;
}
.actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}
.actions .danger-button {
  grid-column: 1 / -1;
  background: #fff0ef;
  color: #c6544d;
}
.history-head {
  margin-top: 34rpx;
}
.task-card {
  padding: 23rpx;
}
.task-card > view,
.section-head > view {
  min-width: 0;
  flex: 1;
}
.task-title,
.section-title {
  overflow-wrap: anywhere;
}
.task-card .status {
  flex-shrink: 0;
}
.task-card text {
  display: block;
}
.state {
  display: grid;
  min-height: 260rpx;
  color: var(--app-muted);
  place-items: center;
}
.state--small {
  min-height: 150rpx;
}
