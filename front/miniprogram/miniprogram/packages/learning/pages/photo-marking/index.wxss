.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}
.notice {
  display: flex;
  padding: 38rpx 32rpx;
  flex-direction: column;
  background: linear-gradient(145deg, #fff, #fff4ec);
  border: 1rpx solid #f3dfd2;
  border-radius: 28rpx;
}
.badge {
  align-self: flex-start;
  padding: 7rpx 15rpx;
  background: #fff0e7;
  border-radius: 999rpx;
  color: #dc621b;
  font-size: 21rpx;
}
.title {
  margin-top: 22rpx;
  color: #2d3436;
  font-size: 40rpx;
  font-weight: 800;
}
.description {
  margin-top: 16rpx;
  color: #737c82;
  font-size: 25rpx;
  line-height: 1.7;
}
.section-title {
  display: block;
  margin: 34rpx 8rpx 18rpx;
  color: #41494e;
  font-size: 28rpx;
  font-weight: 700;
}
.list {
  display: grid;
  gap: 14rpx;
}
.card {
  display: flex;
  padding: 25rpx;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  color: #626b71;
  font-size: 24rpx;
}
.state {
  display: grid;
  min-height: 35vh;
  color: #92999e;
  place-items: center;
}
.state--small {
  min-height: 180rpx;
}
