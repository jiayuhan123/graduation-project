.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.hero {
  display: flex;
  padding: 16rpx 0 34rpx;
  flex-direction: column;
}
.eyebrow {
  color: var(--app-primary);
  font-size: 23rpx;
}
.title {
  margin-top: 12rpx;
  color: var(--app-ink);
  font-size: 46rpx;
  font-weight: 600;
}
.description {
  margin-top: 12rpx;
  color: var(--app-muted);
  font-size: 25rpx;
  line-height: 1.7;
}
.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
}
.section-title {
  display: flex;
  margin-bottom: 26rpx;
  align-items: center;
  gap: 16rpx;
  color: var(--app-ink);
  font-size: 29rpx;
  font-weight: 600;
}
.step-number {
  color: #93a18e;
  font-size: 23rpx;
  font-weight: 400;
}
.chips {
  width: 100%;
  white-space: nowrap;
}
.chip-row {
  display: flex;
  gap: 12rpx;
}
.option-card .chip-row {
  flex-wrap: wrap;
}
.chip,
.number-chip,
.mode-chip {
  min-height: 76rpx;
  margin: 0;
  padding: 0 22rpx;
  flex-shrink: 0;
  background: #f4f5f1;
  border: 1rpx solid #edf0e9;
  border-radius: 12rpx;
  color: #68756a;
  font-size: 25rpx;
  line-height: 74rpx;
}
.chip--active {
  background: var(--app-primary-soft);
  border-color: #9ab2a0;
  color: var(--app-primary);
  font-weight: 600;
}
.number-chip {
  min-width: 80rpx;
}
.point-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.point {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #f7f8f5;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  color: var(--app-text);
  font-size: 27rpx;
  line-height: 1.5;
  text-align: left;
}
.point--active {
  background: var(--app-primary-soft);
  border-color: #9ab2a0;
  color: var(--app-primary);
  font-weight: 500;
}
.point-mark {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c5cec1;
  border-radius: 50%;
  font-size: 22rpx;
}
.point--active .point-mark {
  background: var(--app-primary);
  border-color: var(--app-primary);
  color: #fff;
}
.option-card {
  display: grid;
  gap: 18rpx;
}
.option-card .section-title {
  margin-bottom: 4rpx;
}
.option-label {
  margin-top: 6rpx;
  color: var(--app-muted);
  font-size: 24rpx;
}
.state,
.inline-state {
  display: flex;
  min-height: 180rpx;
  align-items: center;
  justify-content: center;
  color: var(--app-muted);
  font-size: 25rpx;
  text-align: center;
}
.inline-state {
  min-height: 100rpx;
}
.primary-button {
  min-height: 96rpx;
  margin: 32rpx 0 0;
  background: var(--app-primary);
  border-radius: 16rpx;
  color: #fff;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 96rpx;
}
