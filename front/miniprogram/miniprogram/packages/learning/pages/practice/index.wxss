.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}
.hero {
  display: flex;
  padding: 22rpx 8rpx 30rpx;
  flex-direction: column;
}
.eyebrow {
  color: #ff7a2a;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.title {
  margin-top: 10rpx;
  color: #2d3436;
  font-size: 48rpx;
  font-weight: 800;
}
.description {
  margin-top: 12rpx;
  color: #7b8389;
  font-size: 26rpx;
  line-height: 1.65;
}
.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: #fff;
  border: 1rpx solid #eceef0;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 42rpx rgba(45, 52, 54, 0.06);
}
.section-title {
  display: block;
  margin-bottom: 22rpx;
  color: #2d3436;
  font-size: 30rpx;
  font-weight: 700;
}
.chips {
  width: 100%;
  white-space: nowrap;
}
.chip-row {
  display: flex;
  gap: 14rpx;
}
.chip,
.number-chip,
.mode-chip {
  min-height: 66rpx;
  margin: 0;
  padding: 0 24rpx;
  background: #f4f5f6;
  border: 0;
  border-radius: 999rpx;
  color: #687077;
  font-size: 25rpx;
  line-height: 66rpx;
}
.chip::after,
.number-chip::after,
.mode-chip::after,
.point::after,
.primary-button::after {
  border: 0;
}
.chip--active {
  background: #fff0e7;
  color: #e96518;
  font-weight: 700;
}
.point-list {
  display: grid;
  gap: 12rpx;
}
.point {
  display: flex;
  width: 100%;
  min-height: 78rpx;
  margin: 0;
  padding-right: 24rpx;
  align-items: center;
  justify-content: space-between;
  background: #f8f9fa;
  border: 0;
  border-radius: 18rpx;
  color: #465058;
  font-size: 27rpx;
  line-height: 1.4;
  text-align: left;
}
.point--active {
  background: #fff2e9;
  color: #dd6019;
  font-weight: 700;
}
.point-mark {
  color: #ff7a2a;
}
.option-card {
  display: grid;
  gap: 18rpx;
}
.option-label {
  color: #838b92;
  font-size: 24rpx;
}
.state,
.inline-state {
  display: grid;
  min-height: 220rpx;
  color: #92999f;
  place-items: center;
}
.inline-state {
  min-height: 100rpx;
}
.primary-button {
  height: 92rpx;
  margin: 12rpx 0 40rpx;
  background: linear-gradient(135deg, #ff8a3d, #ff6b22);
  border: 0;
  border-radius: 24rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
  box-shadow: 0 16rpx 30rpx rgba(255, 122, 42, 0.24);
}
