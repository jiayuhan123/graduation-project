.practice-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.practice-hero {
  padding: 24rpx 8rpx 12rpx;
}

.practice-hero__eyebrow,
.practice-hero__title,
.practice-hero__description,
.module-card__code,
.module-card__name,
.module-card__theme,
.point-row__name,
.point-row__description,
.practice-action__hint {
  display: block;
}

.practice-hero__eyebrow {
  color: #e96f24;
  font-size: 24rpx;
  font-weight: 650;
}

.practice-hero__title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.practice-hero__description {
  margin-top: 14rpx;
  color: #7b8188;
  font-size: 24rpx;
  line-height: 1.6;
}

.module-scroll {
  width: 100%;
  white-space: nowrap;
}

.module-card {
  display: inline-flex;
  width: 320rpx;
  min-height: 216rpx;
  margin-right: 18rpx;
  padding: 28rpx;
  flex-direction: column;
  vertical-align: top;
  white-space: normal;
  background: #ffffff;
  border: 2rpx solid #eef0f3;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.05);
}

.module-card--active {
  background: linear-gradient(145deg, #fff9f4, #fff1e7);
  border-color: #ff8a3d;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 42, 0.14);
}

.module-card__code {
  color: #e96f24;
  font-size: 21rpx;
  font-weight: 650;
}

.module-card__name {
  margin-top: 14rpx;
  color: #2d3436;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.35;
}

.module-card__theme {
  margin-top: auto;
  padding-top: 18rpx;
  color: #7b8188;
  font-size: 22rpx;
  line-height: 1.45;
}

.points-loading {
  display: flex;
  min-height: 220rpx;
  align-items: center;
  justify-content: center;
}

.point-list {
  overflow: hidden;
}

.point-row {
  display: flex;
  min-height: 108rpx;
  padding-top: 22rpx;
  padding-right: 26rpx;
  padding-bottom: 22rpx;
  align-items: center;
  border-bottom: 1rpx solid #f0f2f5;
  gap: 18rpx;
}

.point-row:last-child {
  border-bottom: 0;
}

.point-row--active {
  background: #fff7f1;
}

.point-row__main {
  min-width: 0;
  flex: 1;
}

.point-row__name {
  font-size: 28rpx;
  font-weight: 650;
}

.point-row__description {
  margin-top: 6rpx;
  overflow: hidden;
  color: #8a8f98;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.point-row__mark {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: #f1f3f5;
  border-radius: 50%;
  color: transparent;
  font-size: 24rpx;
  font-weight: 800;
}

.point-row--active .point-row__mark {
  background: #ff8a3d;
  color: #ffffff;
}

.difficulty-card {
  display: flex;
  padding: 24rpx;
  justify-content: space-between;
  gap: 14rpx;
}

.difficulty-chip {
  display: flex;
  width: 88rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  color: #636e72;
  font-weight: 650;
}

.difficulty-chip--active {
  background: #fff3eb;
  border-color: #ff8a3d;
  color: #e96f24;
}

.practice-action {
  margin-top: 40rpx;
}

.practice-action__hint {
  margin-top: 18rpx;
  padding: 0 20rpx;
  color: #8a8f98;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
