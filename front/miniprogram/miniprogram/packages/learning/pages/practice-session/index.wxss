.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
  box-sizing: border-box;
}
.state {
  display: grid;
  min-height: 70vh;
  color: #8a9298;
  place-items: center;
}
.task-header {
  display: flex;
  padding: 20rpx 8rpx 30rpx;
  align-items: flex-end;
  justify-content: space-between;
}
.task-title,
.task-meta {
  display: block;
}
.task-title {
  color: var(--app-ink);
  font-size: 38rpx;
  font-weight: 600;
}
.task-meta {
  margin-top: 10rpx;
  color: #899197;
  font-size: 24rpx;
}
.progress {
  padding: 10rpx 18rpx;
  background: var(--app-primary-soft);
  border-radius: 12rpx;
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 700;
}
.question-card {
  padding: 38rpx 32rpx;
  background: #fff;
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
  box-shadow: none;
}
.question-number {
  display: block;
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 700;
}
.question-stem {
  display: block;
  margin-top: 24rpx;
  color: #252b2e;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.65;
  white-space: pre-wrap;
}
.question-options {
  display: block;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 18rpx;
  color: #515a61;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.answer-input {
  width: 100%;
  height: 92rpx;
  margin-top: 34rpx;
  padding: 0 26rpx;
  background: var(--app-bg);
  border: 2rpx solid #e4e7e9;
  border-radius: 20rpx;
  color: var(--app-ink);
  font-size: 32rpx;
}
.feedback {
  display: flex;
  margin-top: 26rpx;
  padding: 24rpx;
  flex-direction: column;
  gap: 10rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 1.6;
}
.feedback--correct {
  background: #eaf8ef;
  color: #247c44;
}
.feedback--wrong {
  background: #fff0e9;
  color: #a74b24;
}
.feedback-title {
  font-size: 30rpx;
  font-weight: 600;
}
.analysis {
  opacity: 0.82;
}
.primary-button,
.secondary-button {
  width: 100%;
  height: 86rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 86rpx;
}
.primary-button {
  background: var(--app-primary);
  color: #fff;
}
.secondary-button {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}
.primary-button::after,
.secondary-button::after,
.nav-button::after,
.finish-button::after {
  border: 0;
}
.navigation {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.nav-button,
.finish-button {
  height: 82rpx;
  margin: 0;
  border: 0;
  border-radius: 20rpx;
  font-size: 27rpx;
  line-height: 82rpx;
}
.nav-button {
  background: #fff;
  color: #596168;
}
.nav-button--next {
  color: var(--app-primary);
}
.finish-button {
  background: var(--app-ink);
  color: #fff;
  font-weight: 700;
}

.task-header > view {
  min-width: 0;
  flex: 1;
}
.task-header {
  gap: 20rpx;
  align-items: center;
}
.task-title {
  font-size: 34rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.progress {
  flex-shrink: 0;
  border-radius: 8rpx;
}
.question-track {
  height: 6rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  background: #e2e8dd;
  border-radius: 8rpx;
}
.question-track__fill {
  height: 100%;
  background: var(--app-primary);
  border-radius: 8rpx;
  transition: width 180ms ease;
}
.question-card {
  padding: 34rpx 28rpx;
  border-radius: 18rpx;
}
.question-stem {
  min-height: 120rpx;
  font-size: 38rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}
.answer-input {
  height: 104rpx;
  background: #fafbf7;
  border-color: #b4c5b4;
  border-radius: 12rpx;
}
.completion-note {
  display: flex;
  margin-bottom: 24rpx;
  padding: 20rpx;
  align-items: center;
  gap: 14rpx;
  background: var(--app-primary-soft);
  border-radius: 12rpx;
  color: var(--app-primary);
  font-size: 24rpx;
}
