.page { min-height: 100vh; padding: 32rpx; background: #f7f8fa; box-sizing: border-box; }
.state { display: grid; min-height: 70vh; color: #8a9298; place-items: center; }
.task-header { display: flex; padding: 20rpx 8rpx 30rpx; align-items: flex-end; justify-content: space-between; }
.task-title, .task-meta { display: block; }
.task-title { color: #2d3436; font-size: 38rpx; font-weight: 800; }
.task-meta { margin-top: 10rpx; color: #899197; font-size: 24rpx; }
.progress { padding: 10rpx 18rpx; background: #fff0e7; border-radius: 999rpx; color: #e96518; font-size: 24rpx; font-weight: 700; }
.question-card { padding: 38rpx 32rpx; background: #fff; border: 1rpx solid #eceef0; border-radius: 30rpx; box-shadow: 0 16rpx 46rpx rgba(45, 52, 54, .07); }
.question-number { display: block; color: #ff7a2a; font-size: 24rpx; font-weight: 700; }
.question-stem { display: block; margin-top: 24rpx; color: #252b2e; font-size: 36rpx; font-weight: 700; line-height: 1.65; white-space: pre-wrap; }
.question-options { display: block; margin-top: 20rpx; padding: 20rpx; background: #f8f9fa; border-radius: 18rpx; color: #515a61; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; }
.answer-input { height: 92rpx; margin-top: 34rpx; padding: 0 26rpx; background: #f7f8fa; border: 2rpx solid #e4e7e9; border-radius: 20rpx; color: #2d3436; font-size: 32rpx; }
.feedback { display: flex; margin-top: 26rpx; padding: 24rpx; flex-direction: column; gap: 10rpx; border-radius: 20rpx; font-size: 25rpx; line-height: 1.6; }
.feedback--correct { background: #eaf8ef; color: #247c44; }
.feedback--wrong { background: #fff0e9; color: #a74b24; }
.feedback-title { font-size: 30rpx; font-weight: 800; }
.analysis { opacity: .82; }
.primary-button, .secondary-button { height: 86rpx; margin-top: 28rpx; border: 0; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; line-height: 86rpx; }
.primary-button { background: #ff7a2a; color: #fff; }
.secondary-button { background: #fff0e7; color: #d75d18; }
.primary-button::after, .secondary-button::after, .nav-button::after, .finish-button::after { border: 0; }
.navigation { display: grid; margin-top: 24rpx; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.nav-button, .finish-button { height: 82rpx; margin: 0; border: 0; border-radius: 20rpx; font-size: 27rpx; line-height: 82rpx; }
.nav-button { background: #fff; color: #596168; }
.nav-button--next { color: #e96518; }
.finish-button { background: #2d3436; color: #fff; font-weight: 700; }
