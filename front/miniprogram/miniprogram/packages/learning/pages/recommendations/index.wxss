.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
  box-sizing: border-box;
}
.hero {
  padding: 20rpx 6rpx 28rpx;
}
.title {
  display: block;
  color: var(--app-ink);
  font-size: 46rpx;
  font-weight: 600;
}
.description {
  display: block;
  margin-top: 12rpx;
  color: var(--app-muted);
  font-size: 25rpx;
  line-height: 1.6;
}
.list {
  display: grid;
  gap: 18rpx;
}
.card {
  padding: 30rpx;
  background: #fff;
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8a9298;
  font-size: 22rpx;
}
.badge {
  padding: 7rpx 15rpx;
  background: var(--app-primary-soft);
  border-radius: 12rpx;
  color: var(--app-primary);
}
.point {
  display: block;
  margin-top: 20rpx;
  color: #333a3f;
  font-size: 29rpx;
  font-weight: 600;
}
.reason {
  display: block;
  margin-top: 14rpx;
  color: #687178;
  font-size: 25rpx;
  line-height: 1.65;
}
.actions {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: 1fr 1.4fr;
  gap: 14rpx;
}
.quiet,
.primary {
  height: 72rpx;
  margin: 0;
  border: 0;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 72rpx;
}
.quiet::after,
.primary::after {
  border: 0;
}
.quiet {
  background: #f3f4f5;
  color: #697178;
}
.primary {
  background: var(--app-primary);
  color: #fff;
  font-weight: 700;
}
.state {
  display: grid;
  min-height: 55vh;
  color: var(--app-muted);
  place-items: center;
}
