.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--app-bg);
  box-sizing: border-box;
}
.hero {
  padding: 20rpx 6rpx 28rpx;
}
.title {
  display: block;
  color: var(--app-ink);
  font-size: 46rpx;
  font-weight: 600;
}
.description {
  display: block;
  margin-top: 12rpx;
  color: var(--app-muted);
  font-size: 25rpx;
}
.list {
  display: grid;
  gap: 18rpx;
}
.card {
  padding: 30rpx;
  background: #fff;
  border: 1rpx solid var(--app-line);
  border-radius: 20rpx;
}
.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.point {
  color: #3b4348;
  font-size: 27rpx;
  font-weight: 700;
}
.score {
  color: var(--app-primary);
  font-size: 38rpx;
  font-weight: 600;
}
.track {
  height: 15rpx;
  margin-top: 22rpx;
  overflow: hidden;
  background: #f0f1f2;
  border-radius: 12rpx;
}
.fill {
  height: 100%;
  background: var(--app-soft);
  border-radius: 12rpx;
}
.metrics {
  display: flex;
  margin-top: 20rpx;
  justify-content: space-between;
  color: #858d93;
  font-size: 21rpx;
}
.state {
  display: grid;
  min-height: 55vh;
  color: var(--app-muted);
  place-items: center;
}

.head {
  gap: 20rpx;
}
.point {
  min-width: 0;
  flex: 1;
  overflow-wrap: anywhere;
}
.score {
  flex-shrink: 0;
}
.metrics {
  flex-wrap: wrap;
  gap: 14rpx 24rpx;
}
