# 本文件提供本地调试默认值，基础设施默认连接共享开发服务器。复制为 .env 后可按需覆盖；.env 不提交 Git。
# Docker Compose 会自动读取 .env；本地 Java 进程需在 IDE 中加载或手动导出同名变量。
COMPOSE_PROJECT_NAME=primary-math-platform
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=local

# 微信小程序登录（AppSecret 只允许放在本机 .env 或部署环境变量中）
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信开放平台网站应用扫码登录（需已审核网站应用；回调地址必须使用已备案的授权域名）
WECHAT_WEB_ENABLED=false
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:5173/login/wechat/callback

# PostgreSQL（后端各服务使用同一账号、不同数据库）
DB_HOST=122.51.234.113
DB_USERNAME=root
DB_PASSWORD=111111
POSTGRES_PORT=5432

# Redis
REDIS_HOST=122.51.234.113
REDIS_PASSWORD=111111
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_MAXMEMORY=96mb

# Nacos：共享服务器已开启鉴权，复制后必须填写实际密码。
NACOS_SERVER_ADDR=122.51.234.113:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_SERVER_PORT=8848
NACOS_CONSOLE_PORT=8847
NACOS_GRPC_PORT=9848
NACOS_GRPC_CLIENT_PORT=9849
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=256m
NACOS_JVM_XMN=128m

# RabbitMQ
RABBITMQ_HOST=122.51.234.113
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=111111
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 服务间 HTTP 调用（仅本地开发值；生产环境必须替换为高强度随机 Token）
INTERNAL_API_ENABLED=true
INTERNAL_API_TOKEN=local-internal-token-change-me

# 本地监控
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jenkins 暂时停用，变量仅供以后恢复配置时使用。
JENKINS_WEB_PORT=8080
JENKINS_AGENT_PORT=50000
