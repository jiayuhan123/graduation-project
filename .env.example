# 团队开发统一连接共享服务器基础设施。复制为 .env 后可按需覆盖；.env 不提交 Git。
COMPOSE_PROJECT_NAME=primary-math-platform
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=server

# 微信小程序登录（AppSecret 只允许放在本机 .env 或部署环境变量中）
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信开放平台网站应用扫码登录（需已审核网站应用；回调地址必须使用已备案的授权域名）
WECHAT_WEB_ENABLED=false
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:5173/login/wechat/callback

# PostgreSQL（模块化单体使用一个数据库）
DB_HOST=122.51.234.113
DB_USERNAME=root
DB_PASSWORD=change-me
POSTGRES_PORT=5432
MONOLITH_DB_NAME=monolith_db

# Redis
REDIS_HOST=122.51.234.113
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_MAXMEMORY=96mb

# RabbitMQ
RABBITMQ_HOST=122.51.234.113
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# OCR 工作器等受信任内部调用（生产环境必须替换为高强度随机 Token）
INTERNAL_API_ENABLED=true
INTERNAL_API_TOKEN=change-to-a-long-random-token

# 本地监控
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Jenkins（仅服务器 CI 使用）
JENKINS_WEB_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_USERNAME=admin
JENKINS_ADMIN_PASSWORD=change-me
DOCKER_GID=999
