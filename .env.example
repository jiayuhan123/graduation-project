# 团队开发统一连接共享服务器基础设施。复制为 .env 后可按需覆盖；.env 不提交 Git。
COMPOSE_PROJECT_NAME=primary-math-platform
TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=server

# 微信小程序登录（AppSecret 只允许放在本机 .env 或部署环境变量中）
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信开放平台网站应用扫码登录（需已审核网站应用；回调地址必须使用已备案的授权域名）
WECHAT_WEB_ENABLED=false
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:5173/login/wechat/callback

# PostgreSQL（模块化单体使用一个数据库）
DB_HOST=122.51.234.113
DB_USERNAME=root
DB_PASSWORD=change-me
POSTGRES_PORT=5432
MONOLITH_DB_NAME=monolith_db

# Redis
REDIS_HOST=122.51.234.113
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_MAXMEMORY=96mb

# RabbitMQ
RABBITMQ_HOST=122.51.234.113
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# OCR 工作器等受信任内部调用（生产环境必须替换为高强度随机 Token）
INTERNAL_API_ENABLED=true
INTERNAL_API_TOKEN=change-to-a-long-random-token

# 教学 Agent（Java 负责可信执行，FastAPI 负责模型编排）
AI_ENABLED=false
AI_AGENT_BASE_URL=http://localhost:8100
AI_AGENT_BRIDGE_TOKEN=change-to-a-different-long-random-token
AI_TOOL_SIGNING_SECRET=change-to-at-least-32-random-characters
AI_TOOL_TOKEN_TTL=5m
AI_ACTION_TOKEN_TTL=15m
AI_STREAM_TIMEOUT=120s
AI_CONNECT_TIMEOUT=5s
AI_AGENT_PORT=8100
AI_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL_API_KEY=
AI_MODEL_NAME=qwen3.7-flash
AI_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_BATCH_SIZE=20
AI_MODEL_TIMEOUT_SECONDS=60
AI_MAX_TOOL_ROUNDS=4
AI_DATABASE_POOL_MIN_SIZE=2
AI_DATABASE_POOL_MAX_SIZE=10
AI_CONVERSATION_MEMORY_TTL_SECONDS=604800
AI_CONVERSATION_MAX_MESSAGES=20
AI_CONTEXT_HISTORY_CHARS=24000
AI_RAG_TOP_K=6
AI_RAG_CANDIDATE_K=24
AI_RAG_MIN_SCORE=0.5
AI_MEMORY_TOP_K=4
AI_MEMORY_RETENTION_DAYS=180
AI_TRACE_RETENTION_DAYS=90
AI_MAX_REQUESTS_PER_MINUTE=20
AI_MAX_CONCURRENT_RUNS=32
AI_DOCS_ENABLED=false
JAVA_AI_TOOL_BASE_URL=http://localhost:10000

# 作业图片识别（Java 单体内置工作器；可与教学 Agent 使用同一个百炼 API Key）
AI_OCR_ENABLED=false
AI_OCR_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# 可选：不配置时 Java OCR 复用 AI_MODEL_API_KEY
# AI_OCR_API_KEY=
AI_OCR_MODEL_NAME=qwen-vl-ocr-latest
AI_OCR_CONNECT_TIMEOUT=5s
AI_OCR_READ_TIMEOUT=90s
AI_OCR_FIXED_DELAY_MS=5000
AI_OCR_BATCH_SIZE=2
AI_OCR_MAX_ITEMS=100
AI_OCR_MAX_OUTPUT_TOKENS=4096
AI_OCR_MAX_IMAGE_BYTES=14000000

# 本地监控
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Jenkins（仅服务器 CI 使用）
JENKINS_WEB_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_USERNAME=admin
JENKINS_ADMIN_PASSWORD=change-me
DOCKER_GID=999
