# 本文件只提供本地开发默认值。复制为 .env 后可按本机情况覆盖；.env 不提交 Git。
# Docker Compose 会自动读取 .env；本地 Java 进程需在 IDE 中加载或手动导出同名变量。
COMPOSE_PROJECT_NAME=primary-math-platform
TZ=Asia/Shanghai

# PostgreSQL（后端各服务使用同一账号、不同数据库）
DB_USERNAME=root
DB_PASSWORD=111111
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=111111
REDIS_PORT=6379
REDIS_MAXMEMORY=96mb

# Nacos：当前仅供本机开发，默认关闭鉴权，后续服务器部署时再单独加固。
NACOS_SERVER_ADDR=localhost:8848
NACOS_SERVER_PORT=8848
NACOS_CONSOLE_PORT=8847
NACOS_GRPC_PORT=9848
NACOS_GRPC_CLIENT_PORT=9849
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=256m
NACOS_JVM_XMN=128m

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=111111
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 本地监控
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jenkins 暂时停用，变量仅供以后恢复配置时使用。
JENKINS_WEB_PORT=8080
JENKINS_AGENT_PORT=50000
